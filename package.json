{
  "name": "repo-health-mcp",
  "version": "0.1.0",
  "description": "An MCP server for evaluating the health and contribution readiness of GitHub projects.",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "github",
    "project-health",
    "model-context-protocol"
  ],
  "author": "Ronit Pahuja",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
